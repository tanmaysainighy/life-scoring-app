# Copy to .env and fill in. Never commit the filled-in file — .env is gitignored.

# Optional. Without it the app still works: the deterministic resolver handles
# exact/alias/keyword/similarity matches, and anything it can't resolve asks the
# user to pick the activity instead of guessing.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Defaults to llama-3.3-70b-versatile. Must be a model that
# supports tool calling — check https://console.groq.com/docs/models
GROQ_MODEL=

# Where the SQLite file lives. Defaults to ./data/lifescore.db.
# In a container this must point at a mounted persistent volume, e.g.
# /data/lifescore.db — otherwise every deploy starts from an empty database.
DATABASE_PATH=
